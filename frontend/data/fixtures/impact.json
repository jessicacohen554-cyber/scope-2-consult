d":{"answered":138,"no":38,"oppose_outside":67,"somewhat":23,"yes":10},"stance_mixed":{"answered":34,"no":27,"oppose_outside":3,"somewhat":4,"yes":0},"stance_neutral":{"answered":105,"no":57,"oppose_outside":27,"somewhat":12,"yes":9},"stance_oppose":{"answered":45,"no":26,"oppose_outside":18,"somewhat":1,"yes":0},"stance_support":{"answered":195,"no":86,"oppose_outside":11,"somewhat":66,"yes":32}},"q146_by_venue":{"both":{"answered":14,"no":8,"oppose_outside":0,"somewhat":5,"yes":1},"inventory":{"answered":71,"no":42,"oppose_outside":10,"somewhat":14,"yes":5},"separate":{"answered":94,"no":29,"oppose_outside":0,"somewhat":40,"yes":25},"unspecified":{"answered":16,"no":7,"oppose_outside":1,"somewhat":7,"yes":1}},"q147":{"n":157,"options":[{"n":104,"text":"Provides a complementary metric to quantify actions such as energy storage or demand response"},{"n":99,"text":"Provides additional relevant information for users of GHG data"},{"n":95,"text":"Allows for continued investment in electricity projects outside of my deliverable market boundary"},{"n":89,"text":"Provides additional approaches for target setting"},{"n":76,"text":"Causes less disruption of existing electricity procurement practices"},{"n":21,"text":"Other (please specify)"}]},"q150":{"n":126,"options":[{"n":75,"text":"There is no agreed-on methodology for calculating these impact metrics"},{"n":74,"text":"These metrics may not be appropriately auditable"},{"n":65,"text":"These metrics could result in greenwashing"},{"n":60,"text":"These metrics are not currently required in mandatory disclosure frameworks"},{"n":59,"text":"These metrics are not currently part of target setting programs"},{"n":32,"text":"The existence of impact metrics would divert investment from time-matched and deliverable electricity procurement"},{"n":14,"text":"Other (please specify)"}]},"quotes":{"inventory":[{"n":4,"n_unnamed":3,"orgs":["Sustainability Roundtable Inc"],"quote":"centering causation of new renewable energy within the quality criteria for market-based instruments under attributional accounting"},{"n":3,"n_unnamed":2,"orgs":["REsurety"],"quote":"Excluding the consequential method as an equally viable option to the LBM or MBM prevents organizations from using it to measure impact"},{"n":2,"n_unnamed":0,"orgs":["A Better City","Boston Green Ribbon Commission"],"quote":"The guidelines should incorporate consequential additionality accounting to encourage off-takers invest in projects that will have the greatest impact in GHG reductions"},{"n":2,"n_unnamed":0,"orgs":["BHP","Mining Association of Canada"],"quote":"Granular location matching should be optional (“may” rather than “shall”), where impact can be demonstrated through sourcing from a broader region."},{"n":2,"n_unnamed":1,"orgs":["Boston University"],"quote":"The scope 2 accounting proposal should be tied to consequential accounting to encourage off takers to invest in projects"},{"n":2,"n_unnamed":0,"orgs":["Compose[d]","Evergreen Renewables Inc (Ever.green)"],"quote":"The causal aspect of consequential impact can serve as a qualifying attribute of contractual instruments"},{"n":2,"n_unnamed":0,"orgs":["Corning Incorporated","Hemlock Semiconductor Operations LLC (HSC)"],"quote":"We are in full support of an emissions impact metric, if it includes netting and is included in Scope 2"},{"n":2,"n_unnamed":1,"orgs":["PGIM"],"quote":"Reporting should reflect real world impact as accurately as possible"}],"mixed":[{"n":6,"n_unnamed":3,"orgs":["Association ECS Switzerland (Verein ECS Schweiz)","RECS Energy Certificate Association","Repower AG"],"quote":"Impact metrics, by contrast, describe estimated system-level outcomes and should be treated, if developed, as supplemental voluntary indicators."},{"n":3,"n_unnamed":1,"orgs":["AI + Planetary Justice Alliance","As You Sow"],"quote":"An outside impact metric cannot offer the same true decarbonization"},{"n":1,"n_unnamed":0,"orgs":["2degNRG BV"],"quote":"impact metrics inherently lack the consistency, comparability, and verifiability that a global reporting standard requires."},{"n":1,"n_unnamed":0,"orgs":["Beverage Industry Environmental Roundtable (BIER)"],"quote":"They can be useful as supplemental information, but they shouldn’t change or limit the MBM."},{"n":1,"n_unnamed":0,"orgs":["Electricity Maps"],"quote":"the accuracy of consequential metrics – and consequentially, their usefulness – has never been proven."},{"n":1,"n_unnamed":0,"orgs":["Energy Unlocked"],"quote":"Only if methodological issues can be agreed would it be helpful to have this alternative method."},{"n":1,"n_unnamed":0,"orgs":["EnergyTag Ltd"],"quote":"is not in and of itself a justifiable reason to exclude the development of such a metric."},{"n":1,"n_unnamed":0,"orgs":["Enosi Australia Ltd."],"quote":"Additionality should be a matter of government policy and incentive schemes, rather than part of a scientific measurement regime."}],"oppose":[{"n":17,"n_unnamed":10,"orgs":["Amazon Employees for Climate Justice","Firm Clean Power Corporation","Just Share","Our Energy Limited","SIDENOR GROUP","SmartestEnergy Ltd.","The Breakthrough Institute"],"quote":"To date, there has not been a proposed impact methodology that satisfactorily meets the combined GHGP metrics of integrity, impact, and feasibility."},{"n":6,"n_unnamed":1,"orgs":["Avary Holding (Shenzhen) Co., Ltd.","Avary Technology (India) Private Limited","Hong Qi Sheng Precision Electronics(Qinhuangdao) Co., Ltd.","HongHengSheng Electronical Technology (Huaian) Co., Ltd.","Qing Ding Precision Electronics (Huai'an) Co., Ltd."],"quote":"The introduction of impact metrics external to Scope 2 is discouraged, as it exacerbates reporting fragmentation"},{"n":2,"n_unnamed":1,"orgs":["BKW Energie AG"],"quote":"The introduction of impact metrics risks shifting the purpose of Scope 2 from contractual disclosure to speculative modeling of system effects"},{"n":1,"n_unnamed":0,"orgs":["Action Speaks Louder"],"quote":"Reporting methods based on projections and hypothetical scenarios may be suitable for strategy and planning for targets, but can’t be credibly passed of"},{"n":1,"n_unnamed":0,"orgs":["Arcadis"],"quote":"there is no existing methodology to calculate these metrics across geographies, it is difficult to audit counterfactual statements."},{"n":1,"n_unnamed":0,"orgs":["Beyond Fossil Fuels"],"quote":"If it cannot be guaranteed that companies will use the more credible Market-based inventory method for their reporting, the impact method should be discouraged."},{"n":1,"n_unnamed":0,"orgs":["Carbon Solutions Group"],"quote":"To introduce further novel impact metrics that reduce energy accounting symmetry will only add to the challenges facing this sector."},{"n":1,"n_unnamed":0,"orgs":["Conversio Pty Ltd"],"quote":"Impact metrics outside the Scope 2 inventory lack conceptual clarity, standardised methodologies, and assurance pathways."}],"separate":[{"n":4,"n_unnamed":2,"orgs":["BraveTrace","Lodestone Energy"],"quote":"This is why we fully support the crucial work of the Action & Market Instrument (AMI) workstream for quantifying and reporting GHG impacts of actions."},{"n":2,"n_unnamed":1,"orgs":["ACORE"],"quote":"ACORE supports the development of consequential accounting."},{"n":2,"n_unnamed":1,"orgs":["Corporate Strategy Dept., Osaka Gas Co., LTD."],"quote":"Disclosing avoided emissions using the Impact Method is highly significant"},{"n":1,"n_unnamed":0,"orgs":["ABEEólica - Brazilian Association of Wind Energy and New Technologies"],"quote":"A separate impact metric could complement Scope 2 by capturing the system-level climate impact of electricity-related actions that are not fully reflected in attributional accounting."},{"n":1,"n_unnamed":0,"orgs":["Angeleno Group"],"quote":"introducing Impact Accounting (Emissionality) as a supplementary or \"dual-reporting\" metric."},{"n":1,"n_unnamed":0,"orgs":["Business Council for Sustainable Energy"],"quote":"BCSE is supportive of impact-based accounting approaches that recognize actions contributing to system-level emissions reductions."},{"n":1,"n_unnamed":0,"orgs":["Business Renewables Centre - Canada"],"quote":"While creating a separate metric would yield the benefits we identified above"},{"n":1,"n_unnamed":0,"orgs":["CSR Division"],"quote":"establish a framework that enables separate, side-by-side reporting of the inventory (Scope 2) and impacts outside the inventory (e.g., avoided emissions and additionality)."}]},"stance":{"additional":{"mixed":19,"neutral":49,"oppose":29,"support":132},"all":{"mixed":36,"neutral":241,"oppose":48,"support":264},"causal":{"mixed":2,"neutral":8,"oppose":1,"support":30},"consequential":{"mixed":19,"neutral":47,"oppose":28,"support":178},"impact":{"mixed":33,"neutral":199,"oppose":43,"support":240}},"totals":{"q146_answered":517,"respondents":1072,"with_free_text":1058},"unnamed":{"mixed":{"individual":2,"redacted":11,"unidentifiable":0},"oppose":{"individual":4,"redacted":18,"unidentifiable":1},"support":{"individual":25,"redacted":124,"unidentifiable":1}},"venue":{"mixed":{"both":0,"inventory":5,"separate":27,"unspecified":4},"support":{"both":18,"inventory":105,"separate":108,"unspecified":33}}}
